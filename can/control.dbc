VAL_ 128 State 0 "STARTUP" 1 "DRIVE" 2 "CHARGE" 3 "FAULT" 4 "FAULT_HELD" ;
VAL_ 144 State 0 "STARTUP" 1 "GLV_ON" 2 "TS_ACTIVE" 3 "READY_TO_DRIVE" ;
VAL_ 170 VsmState 0 "START" 1 "PRECHARGE_INIT" 2 "PRECHARGE_ACTIVE" 3 "PRECHARGE_COMPLETE" 4 "WAIT" 5 "READY" 6 "MOTOR_RUNNING" 7 "FAULT" 14 "SHUTDOWN_IN_PROCESS" 15 "RECYCLE_POWER" ;
VAL_ 1536 State 0 "OFF" 1 "WAITING_FOR_GATE" 2 "BALANCING" 3 "PAUSED" 4 "DONE" 5 "STOPPED" ;
VAL_ 1536 Reason 0 "NONE" 1 "SENSE_OPEN" 2 "BMS_FAULT" 3 "CHARGER_SILENT" 4 "BOARD_HOT" 5 "CELLS_HOT" 6 "LOW_CELL" 7 "TIME_LIMIT" 8 "FET_CHECK_FAILED" 9 "CONFIG_REJECTED" ;
VAL_ 2550588916 Control 0 "START" 1 "STOP" ;
VAL_ 2566849012 RIsoStatus 252 "STARTUP_ESTIMATE" 253 "STARTUP_FIRST_VALUE" 254 "NORMAL" 255 "NOT_AVAILABLE" ;

