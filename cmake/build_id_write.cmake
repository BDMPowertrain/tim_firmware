# Writes build_id.h for cmake/build_id.cmake. Run as a script:
#
# A dirty tree keeps HEAD's ID with BUILD_DIRTY set, so two different
# uncommitted images share an ID: whatever matches on the build ID (the
# pedal check, ADR 0016) must treat a dirty build as never matching.
#
#   cmake -DREPO=<repository> -DOUT=<header> -P build_id_write.cmake

set(id 0)
set(dirty 0)

find_package(Git QUIET)
if(GIT_FOUND)
    # The full hash cut to 8 digits: --short may give more when 8 are
    # ambiguous, and more would not fit a uint32_t.
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${REPO} rev-parse HEAD
        OUTPUT_VARIABLE hash RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND hash MATCHES "^[0-9a-f]+$")
        string(SUBSTRING ${hash} 0 8 hash)
        set(id 0x${hash})
        # Tracked files only: a build folder or scratch file is not a change
        # to the image's source.
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${REPO} status --porcelain --untracked-files=no
            OUTPUT_VARIABLE changes RESULT_VARIABLE rc ERROR_QUIET)
        if(rc EQUAL 0 AND NOT changes STREQUAL "")
            set(dirty 1)
        endif()
    endif()
endif()

set(text "/* Generated by cmake/build_id_write.cmake on every build. Not committed. */
#ifndef BUILD_ID_H
#define BUILD_ID_H

#define BUILD_ID    ${id}u
#define BUILD_DIRTY ${dirty}

#endif /* BUILD_ID_H */
")

# Touched only when it changes, so an unchanged tree recompiles nothing.
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
